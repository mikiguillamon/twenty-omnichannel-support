{
  "name": "twenty-omnichannel-support",
  "version": "0.3.0-beta.5",
  "private": false,
  "description": "Native workspace-scoped support console for Twenty CRM: cases, messages, FAQs, channels, QA and dashboards",
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": "^24.5.0",
    "twenty": ">=2.50.0 <2.51.0"
  },
  "scripts": {
    "twenty": "twenty",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "twenty dev:build",
    "check": "node scripts/check-schema.mjs && yarn typecheck && yarn build",
    "check:schema": "node scripts/check-schema.mjs",
    "test": "node --test tests/*.test.mjs",
    "release:check": "node scripts/release-preflight.mjs",
    "prepack": "node -e \"const fs=require('node:fs'),p=require('node:path');if(p.basename(process.cwd())!=='output'||p.basename(p.dirname(process.cwd()))!=='.twenty')throw Error('Publish via Twenty CLI, not the source root');fs.copyFileSync(p.resolve('../../LICENSE'),'LICENSE')\""
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "twenty-client-sdk": "2.50.0",
    "twenty-sdk": "2.50.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "twenty-app",
    "omnichannel",
    "customer-support",
    "whatsapp",
    "email",
    "crm",
    "twenty"
  ],
  "frontComponentSharedDependencies": [
    "react",
    "react-dom/client"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikiguillamon/twenty-omnichannel-support.git"
  },
  "homepage": "https://github.com/mikiguillamon/twenty-omnichannel-support#readme",
  "bugs": {
    "url": "https://github.com/mikiguillamon/twenty-omnichannel-support/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
